<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <AssemblyName>Muselly</AssemblyName>
        <RootNamespace>Muselly.Desktop</RootNamespace>
        <!-- Background (concurrent) workstation GC keeps GC pauses short so the audio render thread isn't
             suspended long enough to underrun the device while the UI does heavy work. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Muselly.App\Muselly.App.csproj" />
        <ProjectReference Include="..\Muselly.Core\Muselly.Core.csproj" />
        <ProjectReference Include="..\Muselly.Audio\Muselly.Audio.csproj" />
        <ProjectReference Include="..\Muselly.Server\Muselly.Server.csproj" />
        <ProjectReference Include="..\Muselly.WebHost\Muselly.WebHost.csproj" />
    </ItemGroup>

    <!-- Bundle the matching pre-built ffmpeg binary (see scripts/build-ffmpeg.sh) next to the app so audio
         decoding is seamless with no user install. The RID is the publish RID when set, else the host RID
         (so `dotnet run` picks up the host build). If the binary hasn't been built yet, nothing is copied
         and the app falls back to an ffmpeg on PATH. -->
    <PropertyGroup>
        <MusellyFfmpegRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</MusellyFfmpegRid>
        <MusellyFfmpegRid Condition="'$(MusellyFfmpegRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</MusellyFfmpegRid>
        <MusellyFfmpegExe>ffmpeg</MusellyFfmpegExe>
        <MusellyFfmpegExe Condition="$(MusellyFfmpegRid.StartsWith('win'))">ffmpeg.exe</MusellyFfmpegExe>
        <MusellyFfmpegPath>$(MSBuildThisFileDirectory)../third_party/ffmpeg/$(MusellyFfmpegRid)/$(MusellyFfmpegExe)</MusellyFfmpegPath>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(MusellyFfmpegPath)')">
        <None Include="$(MusellyFfmpegPath)">
            <Link>$(MusellyFfmpegExe)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <!-- Ship FFmpeg's licence text alongside the binary (LGPL compliance). -->
    <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../third_party/ffmpeg/$(MusellyFfmpegRid)/COPYING.LGPLv2.1')">
        <None Include="$(MSBuildThisFileDirectory)../third_party/ffmpeg/$(MusellyFfmpegRid)/COPYING.LGPLv2.1">
            <Link>FFMPEG-COPYING.LGPLv2.1.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../THIRD_PARTY_NOTICES.md')">
        <None Include="$(MSBuildThisFileDirectory)../THIRD_PARTY_NOTICES.md">
            <Link>THIRD_PARTY_NOTICES.md</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Build the WebAssembly browser app and bundle it into the desktop output as "webapp/", so the
         built-in web server can serve it with no extra steps. Requires the wasm-tools workload. Opt out with
         -p:MusellyBundleWeb=false (e.g. if the workload isn't installed). The web build is invoked with the
         desktop's RID/TFM properties stripped so it uses its own browser-wasm target. -->
    <PropertyGroup>
        <MusellyBundleWeb Condition="'$(MusellyBundleWeb)' == ''">true</MusellyBundleWeb>
        <MusellyWebProject>$(MSBuildThisFileDirectory)../Muselly.Web/Muselly.Web.csproj</MusellyWebProject>
        <MusellyWebBundle>$(MSBuildThisFileDirectory)../Muselly.Web/bin/$(Configuration)/net10.0-browser/browser-wasm/AppBundle</MusellyWebBundle>
    </PropertyGroup>

    <Target Name="BuildMusellyWebApp" Condition="'$(MusellyBundleWeb)' == 'true'" BeforeTargets="Build">
        <Message Importance="high" Text="Building Muselly.Web (browser-wasm) for bundling into the desktop app…" />
        <MSBuild Projects="$(MusellyWebProject)"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun;PublishProtocol;TargetFramework;Platform;PublishDir;RuntimeIdentifierOverride" />
        <ItemGroup>
            <_MusellyWebFiles Include="$(MusellyWebBundle)/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(_MusellyWebFiles)"
              DestinationFiles="@(_MusellyWebFiles->'$(OutDir)webapp/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- On publish, copy the same bundle into the published output's webapp/ folder. -->
    <Target Name="CopyMusellyWebAppToPublish" Condition="'$(MusellyBundleWeb)' == 'true'" AfterTargets="Publish">
        <ItemGroup>
            <_MusellyWebPublishFiles Include="$(MusellyWebBundle)/**/*" />
        </ItemGroup>
        <Copy SourceFiles="@(_MusellyWebPublishFiles)"
              DestinationFiles="@(_MusellyWebPublishFiles->'$(PublishDir)webapp/%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>
</Project>
