<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Muselly.App.ViewModels"
             xmlns:controls="using:Muselly.App.Controls"
             xmlns:models="using:Muselly.Core.Models"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="700"
             x:Class="Muselly.App.Views.UsersView"
             x:DataType="vm:UsersViewModel">

    <Grid Margin="24,12,24,12" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
            <TextBlock Text="Users" Classes="h1"/>
            <TextBlock Classes="subtle" IsVisible="{Binding IsAdminView}"
                       Text="As an admin you can see every user, regardless of their privacy settings."/>
            <TextBlock Classes="subtle" IsVisible="{Binding !IsAdminView}"
                       Text="Public profiles, and your own."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:UserProfile">
                        <Button Classes="ghost" Padding="10" CornerRadius="12" Margin="0,0,8,8"
                                Command="{Binding DataContext.OpenUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Width="150" Spacing="8">
                                <controls:AlbumArt Width="120" Height="120" CornerRadius="60"
                                                   HorizontalAlignment="Center" Source="{Binding ProfilePicturePath}"/>
                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="14"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource CatppuccinText}"/>
                                <TextBlock Text="Built-in admin" FontSize="11" Classes="subtle" TextAlignment="Center"
                                           IsVisible="{Binding IsBuiltIn}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
