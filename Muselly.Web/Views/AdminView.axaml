<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Muselly.Web.ViewModels"
             xmlns:sys="using:System"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="600"
             x:Class="Muselly.Web.Views.AdminView"
             x:DataType="vm:AdminViewModel">
    <Border Classes="card" Padding="20">
        <StackPanel Spacing="14">
            <StackPanel Spacing="2">
                <TextBlock Text="Host library (admin)" Classes="h3"/>
                <TextBlock Classes="caption"
                           Text="These folders live on the server hosting this library, not on your device."/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Folders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <Border Classes="surface" Padding="12,8" Margin="0,3">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource CatppuccinText}"/>
                                <Button Grid.Column="1" Classes="ghost" Content="Rescan" Margin="0,0,8,0"
                                        Command="{Binding DataContext.RescanFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="2" Classes="ghost" Content="Remove"
                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="surface" Padding="12,10">
                <StackPanel Spacing="10">
                    <TextBlock Text="Add folder (path on the host)" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource CatppuccinText}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Grid.Column="0" Text="{Binding NewFolderPath}" PlaceholderText="/music/library"/>
                        <Button Grid.Column="1" Classes="accent" Content="Add" Command="{Binding AddFolderCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="pill" Content="Rescan whole library" Command="{Binding RescanAllCommand}"/>
                <TextBlock Text="{Binding Status}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
