<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Muselly.Audio - dependency-free, cross-platform audio output (CoreAudio/WASAPI/ALSA) plus ffmpeg-CLI decoding for the Muselly player.</Description>
    <Authors>Muselly</Authors>
    <Company>Muselly</Company>
    <Product>Muselly.Audio</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Muselly.Core\Muselly.Core.csproj" />
  </ItemGroup>
</Project>
