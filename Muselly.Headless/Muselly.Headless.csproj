<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>muselly-headless</AssemblyName>
    <RootNamespace>Muselly.Headless</RootNamespace>
    <Description>Muselly.Headless - a UI-less host that runs the integrated TLS server and the web server, sharing the same engine as the desktop app.</Description>
    <Authors>Muselly</Authors>
    <Company>Muselly</Company>
    <Product>Muselly.Headless</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Muselly.Core\Muselly.Core.csproj" />
    <ProjectReference Include="..\Muselly.Server\Muselly.Server.csproj" />
    <ProjectReference Include="..\Muselly.WebHost\Muselly.WebHost.csproj" />
  </ItemGroup>
</Project>
